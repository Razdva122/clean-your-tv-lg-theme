{
  "schemaVersion": 1,
  "themeApiVersion": 1,
  "id": "github:razdva122/clean-your-tv-lg-theme:gallery",
  "title": "Gallery",
  "description": "A light paper landscape, large app cards and a dark serif clock.",
  "author": {
    "name": "Clean Your TV contributors",
    "url": "https://github.com/Razdva122/clean-your-tv-lg-theme"
  },
  "themeVersion": "1.1.0",
  "layout": {
    "preset": "dock-grid",
    "columns": 4,
    "spacingScale": 1,
    "textScale": 1,
    "focusScale": 1.1
